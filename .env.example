# Supabase — projeto do CRM SaaS (ver Settings > API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role — NUNCA expor no cliente, usar só em Route Handlers/webhooks
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (usada em links de e-mail, redirects de auth etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Webhook do Meta Lead Ads (Fase 7 — ainda não implementado)
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
